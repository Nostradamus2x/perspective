# Copy to .env and fill in. .env is gitignored; this file is not.
#
# YouTube Data API v3 key: console.cloud.google.com
#   1. Create a project
#   2. APIs & Services -> Library -> enable "YouTube Data API v3"
#   3. Credentials -> Create credentials -> API key
#   4. Restrict the key to YouTube Data API v3
#
# Free tier is 10,000 quota units/day. A channel search costs 100 units;
# listing a channel's uploads costs 1. Plenty for a daily digest.
YOUTUBE_API_KEY=
